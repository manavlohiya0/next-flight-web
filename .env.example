# Deployment & App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Lemon Squeezy (Merchant of Record - Primary Checkout)
# Get these from your Lemon Squeezy Dashboard: https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
# Webhook signing secret from Lemon Squeezy Dashboard -> Settings -> Webhooks
LEMONSQUEEZY_WEBHOOK_SECRET=
# Direct hosted checkout link fallback (optional)
LEMONSQUEEZY_DIRECT_CHECKOUT_URL=

# Automated GitHub Access Automation
# Create a Personal Access Token with repo (collaborator invite) scope:
# https://github.com/settings/tokens?type=beta (or classic with "repo" scope)
GITHUB_PAT_TOKEN=ghp_...
# The GitHub owner/organization and private repo name where your boilerplate is stored
GITHUB_REPO_OWNER=your-github-username-or-org
GITHUB_REPO_NAME=vibe-saas-boilerplate

# Optional: Stripe (Alternative Provider)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
